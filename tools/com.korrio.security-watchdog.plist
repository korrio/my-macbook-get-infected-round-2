<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.korrio.security-watchdog</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>/Users/korrio/.security-watchdog/watchdog.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/Users/korrio/.security-watchdog/launchd.err.log</string>
	<key>StandardOutPath</key>
	<string>/Users/korrio/.security-watchdog/launchd.out.log</string>
	<key>StartInterval</key>
	<integer>300</integer>
</dict>
</plist>
